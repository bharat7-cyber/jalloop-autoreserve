# JalLoop AutoReserve - Backend Environment Configuration

# Server Port
PORT=8000
HOST=0.0.0.0

# Storage: Local SQLite fallback is used automatically if AWS is unconfigured
SQLITE_DB_PATH=./jalloop.db

# AWS Cloud Integration (Optional for local development, required for production AWS deployment)
# Leave blank or unconfigured to run in Local Persistence (SQLite) mode
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
DYNAMODB_TABLE_NAME=JalLoopCalculations
